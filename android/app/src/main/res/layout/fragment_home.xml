<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/refresh" android:layout_width="match_parent" android:layout_height="match_parent">
<androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingHorizontal="20dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="nftime" android:textColor="@color/black" android:textSize="24sp" android:textStyle="bold" android:letterSpacing="-0.03" />
        <TextView android:id="@+id/chain" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_kaia" android:paddingHorizontal="10dp" android:paddingVertical="4dp"
            android:text="Kaia Kairos" android:textColor="#FF3D4A00" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/greet" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp" android:layout_marginTop="4dp"
        android:text="오늘의 큐레이션" android:textColor="@color/text2" android:textSize="13sp" />

    <FrameLayout android:id="@+id/curatedCard" android:layout_width="match_parent" android:layout_height="440dp"
        android:layout_marginHorizontal="20dp" android:layout_marginTop="10dp" android:foreground="?attr/selectableItemBackground">
        <com.google.android.material.imageview.ShapeableImageView android:id="@+id/curatedImg"
            android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"
            android:background="@color/surface" app:shapeAppearanceOverlay="@style/Shape.R20" />
        <com.google.android.material.imageview.ShapeableImageView android:layout_width="match_parent" android:layout_height="200dp"
            android:layout_gravity="bottom" android:src="@drawable/bg_scrim_bottom" android:scaleType="fitXY"
            app:shapeAppearanceOverlay="@style/Shape.R20" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
            android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_dark"
                android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:text="TODAY'S PICK"
                android:textColor="@color/white" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/curatedTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:textColor="@color/white" android:textSize="26sp" android:textStyle="bold" />
            <TextView android:id="@+id/curatedSub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textColor="#CCFFFFFF" android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView style="@style/Section" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="20dp" android:layout_marginTop="28dp" android:text="새로 나온 작품" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/listNew" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp" android:clipToPadding="false"
        android:paddingHorizontal="20dp" android:nestedScrollingEnabled="false" />

    <TextView style="@style/Section" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="20dp" android:layout_marginTop="28dp" android:text="지금 인기있는 작품" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/listPopular" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp" android:clipToPadding="false"
        android:paddingHorizontal="20dp" android:nestedScrollingEnabled="false" />

    <TextView style="@style/Section" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="20dp" android:layout_marginTop="28dp" android:text="아티스트" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:scrollbars="none">
        <LinearLayout android:id="@+id/artists" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingHorizontal="14dp" />
    </HorizontalScrollView>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
