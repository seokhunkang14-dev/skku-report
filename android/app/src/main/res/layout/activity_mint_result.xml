<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:gravity="center_horizontal" android:padding="24dp">
    <com.google.android.material.imageview.ShapeableImageView android:id="@+id/art" android:layout_width="170dp" android:layout_height="300dp"
        android:layout_marginTop="16dp" android:scaleType="centerCrop" android:background="@color/surface"
        android:elevation="8dp" app:shapeAppearanceOverlay="@style/Shape.R12" />
    <TextView android:id="@+id/headline" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:gravity="center" android:lineSpacingExtra="4dp"
        android:textColor="@color/black" android:textSize="21sp" android:textStyle="bold" />
    <TextView android:id="@+id/subline" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:gravity="center" android:textColor="@color/text2" android:textSize="13sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
        android:background="@drawable/bg_round_surface" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/details" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:lineSpacingExtra="6dp" android:textColor="@color/text" android:textSize="12sp" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnExplorer" style="@style/Btn.Outline"
        android:layout_width="match_parent" android:layout_marginTop="20dp" android:text="Kaiascan에서 발행 내역 확인" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnWallpaper" style="@style/Btn.Primary"
        android:layout_width="match_parent" android:layout_marginTop="10dp" android:text="바로 배경화면으로 설정" />
    <TextView android:id="@+id/btnDone" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp"
        android:gravity="center" android:text="라이브러리로 가기" android:textColor="@color/text2" android:textSize="14sp"
        android:background="?attr/selectableItemBackground" />
</LinearLayout>
</ScrollView>
