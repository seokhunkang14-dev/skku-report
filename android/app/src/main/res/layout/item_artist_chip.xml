<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="88dp" android:layout_height="wrap_content" android:orientation="vertical"
    android:gravity="center_horizontal" android:layout_marginHorizontal="6dp">
    <com.google.android.material.imageview.ShapeableImageView android:id="@+id/img"
        android:layout_width="72dp" android:layout_height="72dp" android:scaleType="centerCrop"
        android:background="@color/surface" app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="@color/text" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
